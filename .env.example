# 복사해서 .env로 만들고 값을 채운다. .env는 git에서 제외된다.

# watsonx Orchestrate SaaS 접속 정보
WXO_URL=
WXO_API_KEY=

# A안: IBM Cloud Db2 SaaS (서비스 자격 증명에서 확인)
DB2_HOST=
DB2_PORT=
DB2_DATABASE=
DB2_USER=
DB2_PASSWORD=
DB2_SSL=true
DB2_SSL_CERT=secrets/db2_ca.crt
DB2_SCHEMA=FIN_DEMO

# B안: watsonx.data intelligence (IKC / wxdi) - B-0 확인에 필요
# WXDI_URL은 서비스 인스턴스 URL (예: https://api.ca-tor.dai.cloud.ibm.com). 경로는 넣지 않는다.
WXDI_URL=
WXDI_API_KEY=
# IBM Cloud IAM 토큰 발급용 (기본값 사용 가능)
IBM_IAM_URL=https://iam.cloud.ibm.com
# 선택: 이미 만든 IKC 프로젝트가 있으면 ID를 넣는다.
WXDI_PROJECT_ID=

# B안: watsonx.data Presto (있을 때만. 없으면 비워 둔다)
PRESTO_HOST=
PRESTO_PORT=
PRESTO_USER=ibmlhapikey_<user>
PRESTO_API_KEY=
